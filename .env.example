# Copy this file to .env.local and fill in the values from your Supabase project
# (Supabase dashboard → Connect, or Project Settings → API Keys).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Never add the service_role / secret key here. This app doesn't need it.

# Feedback emails (optional). Get a free API key at https://resend.com → API Keys.
# Without a verified domain, Resend only delivers to the email you signed up with,
# so use that address here. These are server-only: no NEXT_PUBLIC_ prefix.
RESEND_API_KEY=re_xxxxxxxxxxxx
FEEDBACK_TO_EMAIL=you@example.com
# FEEDBACK_FROM_EMAIL="Ticked Feedback <feedback@yourdomain.com>"  # only with a verified domain
